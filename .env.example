# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=development
POSTGRES_DB=stockpilot
POSTGRES_PORT=5432

# ── Connection strings (host paths; compose overrides them
#    for containers with the db/redis hostnames) ───────────
DATABASE_URL=postgresql://stockpilot:development@localhost:5432/stockpilot
REDIS_URL=redis://localhost:6379

# ── Ports ─────────────────────────────────────────────────
API_PORT=8080
WEB_PORT=3000
REDIS_PORT=6379

# ── Browser-exposed ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
