{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "outDir": "./dist",
        "sourceMap": true,
        "incremental": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
        },
    },
    "include": ["src/**/*", "test/**/*"],
}
